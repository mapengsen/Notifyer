<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notifyer" Width="280" Height="440" MinWidth="180" MinHeight="200"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" FontFamily="Microsoft YaHei UI, Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBackground" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#CDD8E6"/>
    <SolidColorBrush x:Key="TitleForeground" Color="#000000"/>
    <SolidColorBrush x:Key="MutedForeground" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#E5ECF5"/>
    <SolidColorBrush x:Key="PinBackground" Color="#D5EEE3"/>
    <SolidColorBrush x:Key="NotificationOn" Color="#D5EEE3"/>
    <SolidColorBrush x:Key="NotificationOff" Color="#F0DFDF"/>
    <SolidColorBrush x:Key="RunningBackground" Color="#E2F0FF"/>
    <SolidColorBrush x:Key="RunningForeground" Color="#000000"/>
    <SolidColorBrush x:Key="UnreadBackground" Color="#FFF0D9"/>
    <SolidColorBrush x:Key="UnreadForeground" Color="#000000"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#D6E0EC"/>
    <SolidColorBrush x:Key="UnreadBorder" Color="#E0BC7E"/>
    <SolidColorBrush x:Key="TextForeground" Color="#000000"/>
    <SolidColorBrush x:Key="MetadataForeground" Color="#D02020"/>
    <SolidColorBrush x:Key="Accent" Color="#38B49A"/>
    <SolidColorBrush x:Key="StatusIndicator" Color="#1676D2"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#ACBCD0"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Border Background="{DynamicResource ScrollThumb}" CornerRadius="4" Margin="2,0"/>
                </ControlTemplate></Thumb.Template></Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ResizeHandle" TargetType="Thumb">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
      <Setter Property="Focusable" Value="False"/>
    </Style>
  </Window.Resources>
  <Grid>
  <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}"
          BorderThickness="1" CornerRadius="12" Padding="10,8">
    <Grid x:Name="MainLayout">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="Header" Background="Transparent" Cursor="SizeAll">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,6,0"/>
          <TextBlock Grid.Column="1" Text="Notifyer" Foreground="{DynamicResource TitleForeground}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="FontDecreaseButton" Content="A−" FontSize="11" Width="26" Padding="2,4" Margin="0,0,3,0" ToolTip="缩小字体" AutomationProperties.Name="缩小字体"/>
          <Button x:Name="FontIncreaseButton" Content="A+" FontSize="11" Width="26" Padding="2,4" Margin="0,0,3,0" ToolTip="放大字体" AutomationProperties.Name="放大字体"/>
          <Button x:Name="ThemeButton" Content="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="22" Padding="3,4"
                  Margin="0,0,3,0" ToolTip="切换白天 / 夜晚配色" AutomationProperties.Name="切换白天或夜晚配色"/>
          <Button x:Name="CollapseButton" Content="−" Width="22" Padding="3,3" Margin="0,0,3,0" ToolTip="折叠 / 展开"/>
          <Button x:Name="HideButton" Content="×" Width="22" Padding="3,3" ToolTip="隐藏；点击 VS Code 底部 Notifyer 图标重新显示"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
          <Button x:Name="NotificationButton" Content="桌面通知 关" FontSize="10" Padding="7,4" Margin="0,0,5,0" ToolTip="开启 / 关闭所有窗口的桌面通知"/>
          <Button x:Name="PinButton" Content="置顶" FontSize="10" Padding="7,4" ToolTip="切换始终置顶"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource RunningBackground}" CornerRadius="6" Padding="7,6" Margin="0,0,3,0">
          <TextBlock x:Name="RunningCount" Text="运行中  0" Foreground="{DynamicResource RunningForeground}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource UnreadBackground}" CornerRadius="6" Padding="7,6" Margin="3,0,0,0">
          <TextBlock x:Name="UnreadCount" Text="待查看  0" Foreground="{DynamicResource UnreadForeground}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Grid>
      <Grid x:Name="Body" Grid.Row="2" Margin="0,8,0,0">
        <ScrollViewer x:Name="SessionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="SessionList"/>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
  <Thumb x:Name="ResizeN" Style="{StaticResource ResizeHandle}" Tag="Top" Height="6" VerticalAlignment="Top" Margin="8,0,8,0" Cursor="SizeNS"/>
  <Thumb x:Name="ResizeS" Style="{StaticResource ResizeHandle}" Tag="Bottom" Height="6" VerticalAlignment="Bottom" Margin="8,0,8,0" Cursor="SizeNS"/>
  <Thumb x:Name="ResizeW" Style="{StaticResource ResizeHandle}" Tag="Left" Width="6" HorizontalAlignment="Left" Margin="0,8,0,8" Cursor="SizeWE"/>
  <Thumb x:Name="ResizeE" Style="{StaticResource ResizeHandle}" Tag="Right" Width="6" HorizontalAlignment="Right" Margin="0,8,0,8" Cursor="SizeWE"/>
  <Thumb x:Name="ResizeNW" Style="{StaticResource ResizeHandle}" Tag="TopLeft" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
  <Thumb x:Name="ResizeNE" Style="{StaticResource ResizeHandle}" Tag="TopRight" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
  <Thumb x:Name="ResizeSW" Style="{StaticResource ResizeHandle}" Tag="BottomLeft" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
  <Thumb x:Name="ResizeSE" Style="{StaticResource ResizeHandle}" Tag="BottomRight" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
  </Grid>
</Window>
