{
  "name": "codex-task-companion",
  "displayName": "Notifyer",
  "description": "Local desktop notifications for Codex and Claude main-task completion and long-running terminal commands in VS Code.",
  "version": "0.3.4",
  "publisher": "pengsen",
  "license": "MIT",
  "icon": "resources/images/vscode-plugin.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapengsen/Notifyer.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "codex",
    "claude",
    "anthropic",
    "openai",
    "notification",
    "python",
    "terminal"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onTerminalShellIntegration:*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexTaskCompanion.testNotification",
        "title": "Notifyer: Test Desktop Notification"
      },
      {
        "command": "codexTaskCompanion.showDiagnostics",
        "title": "Notifyer: Show Diagnostics"
      },
      {
        "command": "codexTaskCompanion.openSettings",
        "title": "Notifyer: Open Settings"
      }
    ],
    "configuration": {
      "title": "Notifyer",
      "properties": {
        "codexTaskCompanion.notifications.mode": {
          "type": "string",
          "enum": [
            "Desktop",
            "VS Code",
            "Both"
          ],
          "default": "Desktop",
          "description": "通知发送到桌面、VS Code，或两者同时发送。桌面通知失败时会自动回退到 VS Code 通知。"
        },
        "codexTaskCompanion.notifications.onlyWhenWindowUnfocused": {
          "type": "boolean",
          "default": false,
          "description": "仅在 VS Code 窗口未获得焦点时发送通知。"
        },
        "codexTaskCompanion.notifications.openVsCodeOnClick": {
          "type": "boolean",
          "default": true,
          "description": "点击桌面通知后尝试把对应的 VS Code 窗口切回前台。Windows 使用原生辅助脚本，其他平台使用 VS Code 命令。"
        },
        "codexTaskCompanion.codex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 Codex 主任务完成通知和会话监控。子 agent 会话始终不会触发通知。"
        },
        "codexTaskCompanion.codex.sessionsRoot": {
          "type": "string",
          "default": "",
          "description": "Codex sessions 目录。留空自动查找 ~/.codex/sessions；远程环境自动查找失败时可填写远程路径。"
        },
        "codexTaskCompanion.codex.sessionPollMs": {
          "type": "number",
          "default": 1500,
          "minimum": 500,
          "description": "Codex 会话 JSONL 的轮询间隔（毫秒）。"
        },
        "codexTaskCompanion.codex.sessionLookbackDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 14,
          "description": "扫描最近多少天的 Codex 会话文件。"
        },
        "codexTaskCompanion.codex.notifyInitialScan": {
          "type": "boolean",
          "default": false,
          "description": "首次扫描时是否也通知已经完成的历史主任务。默认关闭，避免启动 VS Code 时产生历史通知。"
        },
        "codexTaskCompanion.claude.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 Claude 主任务完成通知和会话监控。Claude 子 agent 不会触发通知。"
        },
        "codexTaskCompanion.claude.projectsRoot": {
          "type": "string",
          "default": "",
          "description": "Claude Code projects 目录。留空自动查找 ~/.claude/projects。"
        },
        "codexTaskCompanion.claude.sessionPollMs": {
          "type": "number",
          "default": 1500,
          "minimum": 500,
          "description": "Claude 会话 JSONL 的轮询间隔（毫秒）。"
        },
        "codexTaskCompanion.claude.sessionLookbackDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "description": "扫描最近多少天有变化的 Claude 会话文件。"
        },
        "codexTaskCompanion.claude.notifyInitialScan": {
          "type": "boolean",
          "default": false,
          "description": "首次扫描时是否通知已经完成的历史 Claude 主任务。默认关闭。"
        },
        "codexTaskCompanion.terminal.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用普通 VS Code 终端命令完成通知。"
        },
        "codexTaskCompanion.terminal.pythonOnly": {
          "type": "boolean",
          "default": true,
          "description": "仅在 Python 命令完成时发送终端通知（默认开启）。支持 python、python3、python3.12、py、pythonw，以及 /opt/conda/envs/.../bin/python 等完整可执行文件路径；关闭后恢复监听忽略列表之外的全部命令。"
        },
        "codexTaskCompanion.terminal.ignoredCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "alias",
            "bg",
            "cat",
            "cd",
            "clear",
            "cls",
            "command",
            "date",
            "df",
            "dirs",
            "du",
            "echo",
            "dir",
            "exit",
            "false",
            "fg",
            "free",
            "head",
            "help",
            "history",
            "id",
            "jobs",
            "l",
            "la",
            "less",
            "ll",
            "ls",
            "logout",
            "man",
            "more",
            "popd",
            "printf",
            "pwd",
            "pushd",
            "set",
            "source",
            "tail",
            "true",
            "type",
            "unalias",
            "uname",
            "unset",
            "uptime",
            "whoami",
            "which",
            "where"
          ],
          "description": "命令名在此列表中时不发送通知。默认的仅 Python 模式下可用它排除特定 Python 命令；关闭 terminal.pythonOnly 后，它用于过滤所有终端命令，例如 ls、ll、pwd。"
        },
        "codexTaskCompanion.terminal.notifyOnFailure": {
          "type": "boolean",
          "default": true,
          "description": "终端命令以非零退出码结束时是否也发送通知。"
        },
        "codexTaskCompanion.terminal.cooldownMs": {
          "type": "number",
          "default": 1500,
          "minimum": 0,
          "description": "同一终端连续通知之间的最小间隔（毫秒）。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test:unit": "npm run compile && node --test out/src/test/core.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && vsce package"
  },
  "dependencies": {
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/node-notifier": "^8.0.5",
    "@types/vscode": "1.93.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.5.4"
  }
}
